<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.BorderPane?>
<?import org.romstation.application.view.control.cell.*?>
<?import org.romstation.application.view.control.cell.entity.*?>
<?import org.romstation.application.view.controller.library.table.*?>
<?import java.lang.*?>

<BorderPane styleClass="table" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.library.table.LibraryTableViewController">
   <center>
      <TableView fx:id="tableView" BorderPane.alignment="CENTER" onKeyPressed="#keyPressed">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.id" >
               <cellFactory>
                  <NumericTableCell.Factory />
               </cellFactory>
               <cellValueFactory>
                  <PropertyValueFactory property="id"/>
               </cellValueFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="ID" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.title" >
               <cellValueFactory>
                  <PropertyValueFactory property="title"/>
               </cellValueFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="TITLE" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.system" >
               <cellValueFactory>
                  <PropertyValueFactory property="system"/>
               </cellValueFactory>
               <cellFactory>
                  <SystemTableCell.Factory/>
               </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="SYSTEM" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.languages" >
               <cellValueFactory>
                  <PropertyValueFactory property="languages"/>
               </cellValueFactory>
               <cellFactory>
                  <LanguagesTableCell.Factory/>
               </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="LANGUAGES" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.genres" >
               <cellValueFactory>
                  <PropertyValueFactory property="genres"/>
               </cellValueFactory>
               <cellFactory>
                  <GenresTableCell.Factory/>
               </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="GENRES" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.players" >
               <cellFactory>
                  <NumericTableCell.Factory />
               </cellFactory>
               <cellValueFactory>
                  <PropertyValueFactory property="players"/>
               </cellValueFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="PLAYERS" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.year" >
               <cellFactory>
                  <NumericTableCell.Factory />
               </cellFactory>
               <cellValueFactory>
                  <PropertyValueFactory property="year"/>
               </cellValueFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="YEAR" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.developer" >
               <cellValueFactory>
                  <PropertyValueFactory property="developer"/>
               </cellValueFactory>
               <cellFactory>
                  <DeveloperTableCell.Factory/>
               </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="DEVELOPER" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.publisher" >
               <cellValueFactory>
                  <PropertyValueFactory property="publisher"/>
               </cellValueFactory>
               <cellFactory>
                  <PublisherTableCell.Factory/>
               </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="PUBLISHER" />
               </userData>
            </TableColumn>
            <TableColumn fx:id="filesTableColumn" prefWidth="75.0" text="%library.view.table.tableView.column.files" >
               <cellFactory>
                  <NumericTableCell.Factory />
               </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="FILES" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.lastUse" >
               <cellValueFactory>
                  <PropertyValueFactory property="lastUse"/>
               </cellValueFactory>
                <cellFactory>
                    <DateTableCell.Factory pattern="%date.tableCell.pattern" />
                </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="LAST_USE" />
               </userData>
            </TableColumn>
            <TableColumn prefWidth="75.0" text="%library.view.table.tableView.column.played" >
               <cellValueFactory>
                  <PropertyValueFactory property="played"/>
               </cellValueFactory>
                <cellFactory>
                    <PlayedTableCell.Factory />
                </cellFactory>
               <userData>
                  <LibraryTableViewColumn fx:constant="PLAYED" />
               </userData>
            </TableColumn>
         </columns>
      </TableView>
   </center>
   <bottom>
      <ToolBar styleClass="bottom" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="launchButton" onAction="#launch" >
               <tooltip>
                  <Tooltip text="%library.view.table.launch" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="launch" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="editButton" onAction="#edit" >
               <tooltip>
                  <Tooltip text="%library.view.table.edit" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="edit" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="deleteButton" onAction="#delete" >
               <tooltip>
                  <Tooltip text="%library.view.table.delete" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="delete" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="openExplorerButton" onAction="#openExplorer">
               <tooltip>
                  <Tooltip text="%library.view.table.explorer" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="explorer" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="showLinksButton" onAction="#showLinks">
               <tooltip>
                  <Tooltip text="%library.view.table.links" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="links" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
         </items>
      </ToolBar>
   </bottom>
</BorderPane>

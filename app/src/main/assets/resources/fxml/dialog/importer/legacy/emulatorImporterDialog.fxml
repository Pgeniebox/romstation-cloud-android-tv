<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>

<DialogPane fx:id="dialogPane" headerText="%legacyEmulatorImporterDialog.header" id="legacy-emulator-importer-dialog" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.bc">
   <buttonTypes>
      <ButtonType fx:constant="CANCEL" />
      <ButtonType fx:constant="OK" />
   </buttonTypes>
    <graphic>
        <FontAwesomeIconView />
    </graphic>
   <content>
      <VBox>
         <children>
               <TableView fx:id="tableView" editable="true" VBox.vgrow="ALWAYS">
                   <columns>
                       <TableColumn fx:id="checkBoxTableColumn" prefWidth="75.0">
                           <graphic>
                               <CheckBox fx:id="checkBox" mnemonicParsing="false" />
                           </graphic>
                       </TableColumn>
                       <TableColumn fx:id="nameTableColumn" prefWidth="300" text="%legacyEmulatorImporterDialog.emulators.tableView.column.name">
                           <cellValueFactory>
                               <PropertyValueFactory property="name" />
                           </cellValueFactory>
                       </TableColumn>
                   </columns>
               </TableView>
               <Label fx:id="alertLabel" maxWidth="Infinity" styleClass="alert" text="%legacyEmulatorImporterDialog.alert" wrapText="true">
                   <graphic>
                       <FontAwesomeIconView />
                   </graphic>
               </Label>
         </children>
      </VBox>
   </content>
</DialogPane>

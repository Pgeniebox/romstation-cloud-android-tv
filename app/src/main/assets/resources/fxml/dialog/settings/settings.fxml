<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<DialogPane id="settings-dialog" headerText="%settings.dialog.header" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.bL">
    <buttonTypes>
      <ButtonType fx:constant="CANCEL" />
      <ButtonType fx:constant="OK" />
   </buttonTypes>
   <content>
       <TabPane tabClosingPolicy="UNAVAILABLE">
           <Tab text="%settings.dialog.application">
               <fx:include source="applicationSettings.fxml" />
           </Tab>
           <Tab text="%settings.dialog.browser">
               <fx:include source="browserSettings.fxml" />
           </Tab>
           <Tab text="%settings.dialog.paths">
               <fx:include source="pathsSettings.fxml" />
           </Tab>
       </TabPane>
   </content>
    <graphic>
        <FontAwesomeIconView />
    </graphic>
</DialogPane>

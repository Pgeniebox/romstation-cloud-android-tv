<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.BorderPane?>
<?import org.romstation.application.view.control.cell.*?>
<?import org.romstation.application.view.control.cell.entity.*?>

<?import java.lang.*?>
<BorderPane styleClass="table" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.emulators.table.EmulatorsTableViewController">
   <center>
      <TableView fx:id="tableView" BorderPane.alignment="CENTER" onKeyPressed="#keyPressed">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="75.0" text="%emulators.view.table.tableView.column.id">
               <cellFactory>
                  <NumericTableCell.Factory />
               </cellFactory>
               <cellValueFactory>
                  <PropertyValueFactory property="id" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="nameColumn" prefWidth="75.0" text="%emulators.view.table.tableView.column.name">
               <cellValueFactory>
                  <PropertyValueFactory property="name" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="filesColumn" prefWidth="75.0" text="%emulators.view.table.tableView.column.files">
               <cellFactory>
                  <NumericTableCell.Factory />
               </cellFactory>
            </TableColumn>
            <TableColumn fx:id="systemsColumn" prefWidth="75.0" text="%emulators.view.table.tableView.column.systems">
               <cellValueFactory>
                  <PropertyValueFactory property="systems" />
               </cellValueFactory>
               <cellFactory>
                  <SystemsTableCell.Factory />
               </cellFactory>
            </TableColumn>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <ToolBar styleClass="bottom" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="launchButton" onAction="#launch" >
               <tooltip>
                  <Tooltip text="%emulators.view.table.launch" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="launch" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="editButton" onAction="#edit" >
               <tooltip>
                  <Tooltip text="%emulators.view.table.edit" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="edit" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="deleteButton" onAction="#delete" >
               <tooltip>
                  <Tooltip text="%emulators.view.table.delete" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="delete" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="openExplorerButton" onAction="#openExplorer" >
               <tooltip>
                  <Tooltip text="%emulators.view.table.explorer" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="explorer" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
            <Button fx:id="showLinksButton" onAction="#showLinks" >
               <tooltip>
                  <Tooltip text="%emulators.view.table.links" />
               </tooltip>
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <styleClass>
                  <String fx:value="links" />
                  <String fx:value="transparent" />
               </styleClass>
            </Button>
         </items>
      </ToolBar>
   </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.layout.VBox?>
<DialogPane headerText="%linkEditorDialog.header" id="link-editor-dialog" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.aP">
    <buttonTypes>
        <ButtonType fx:constant="CANCEL" />
        <ButtonType fx:constant="OK" />
    </buttonTypes>
    <graphic>
        <FontAwesomeIconView />
    </graphic>
    <content>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>
            <children>
                <VBox styleClass="named-field">
                    <Label text="%linkEditorDialog.name"/>
                    <TextField fx:id="nameTextField"/>
                </VBox>
                <VBox styleClass="named-field" GridPane.rowIndex="1">
                    <Label text="%linkEditorDialog.location"/>
                    <TextField fx:id="locationTextField"/>
                </VBox>
                <CheckBox fx:id="externalCheckBox" text="%linkEditorDialog.external" GridPane.rowIndex="2" />
            </children>
        </GridPane>
    </content>
</DialogPane>
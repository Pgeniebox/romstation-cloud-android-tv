<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.*?>
<?import org.romstation.application.view.control.cell.NumericTableCell.Factory?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.LinksPaneController">
    <styleClass>
        <String fx:value="entity-pane"/>
        <String fx:value="links"/>
    </styleClass>
    <top>
        <ToolBar>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#add">
                <tooltip>
                    <Tooltip text="%linksPane.add"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="add"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#edit">
                <tooltip>
                    <Tooltip text="%linksPane.edit"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="edit"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#delete">
                <tooltip>
                    <Tooltip text="%linksPane.delete"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="delete"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
        </ToolBar>
    </top>
    <center>
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idTableColumn" prefWidth="75.0" text="%linksPane.tableView.column.id">
                    <cellFactory>
                        <NumericTableCell.Factory/>
                    </cellFactory>
                    <cellValueFactory>
                        <PropertyValueFactory property="id"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="nameTableColumn" text="%linksPane.tableView.column.name">
                    <cellValueFactory>
                        <PropertyValueFactory property="name"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="locationTableColumn" text="%linksPane.tableView.column.location">
                    <cellValueFactory>
                        <PropertyValueFactory property="location"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="externalTableColumn" prefWidth="75.0" text="%linksPane.tableView.column.external">
                    <cellValueFactory>
                        <PropertyValueFactory property="external"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>

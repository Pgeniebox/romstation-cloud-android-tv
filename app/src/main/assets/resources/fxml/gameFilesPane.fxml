<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import org.romstation.application.view.control.cell.*?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.*?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.GameFilesPaneController">
    <styleClass>
        <String fx:value="entity-pane"/>
        <String fx:value="game-files"/>
    </styleClass>
    <top>
        <ToolBar>
            <Button mnemonicParsing="false" onAction="#create">
                <tooltip>
                    <Tooltip text="%gameFilesPane.add"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="add"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button mnemonicParsing="false" onAction="#importFile">
                <tooltip>
                    <Tooltip text="%gameFilesPane.import"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="import"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copy">
                <tooltip>
                    <Tooltip text="%gameFilesPane.copy"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="copy"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#edit">
                <tooltip>
                    <Tooltip text="%gameFilesPane.edit"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="edit"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#delete">
                <tooltip>
                    <Tooltip text="%gameFilesPane.delete"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="delete"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
            <Button fx:id="explorerButton" mnemonicParsing="false" onAction="#openExplorer">
                <tooltip>
                    <Tooltip text="%gameFilesPane.explorer"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView/>
                </graphic>
                <styleClass>
                    <String fx:value="explorer"/>
                    <String fx:value="transparent"/>
                </styleClass>
            </Button>
        </ToolBar>
    </top>
    <center>
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idTableColumn" prefWidth="75.0" text="%gameFilesPane.tableView.column.id">
                    <cellFactory>
                        <NumericTableCell.Factory />
                    </cellFactory>
                    <cellValueFactory>
                        <PropertyValueFactory property="id"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="nameTableColumn" prefWidth="75.0" text="%gameFilesPane.tableView.column.name">
                    <cellValueFactory>
                        <PropertyValueFactory property="name"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="profilesTableColumn" prefWidth="75.0" text="%gameFilesPane.tableView.column.profiles">
                    <cellFactory>
                        <NumericTableCell.Factory />
                    </cellFactory>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>
<DialogPane id="create-server-dialog" fx:id="dialogPane" headerText="%createServerDialog.header" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.bg">
    <graphic>
        <FontAwesomeIconView />
    </graphic>
    <content>
      <VBox>
         <children>
            <TitledPane fx:id="serverTitledPane" collapsible="false" styleClass="server" text="%createServerDialog.server">
               <content>
                   <GridPane fx:id="serverGridPane">
                       <columnConstraints>
                           <ColumnConstraints hgrow="NEVER" />
                           <ColumnConstraints hgrow="SOMETIMES" />
                           <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" />
                       </columnConstraints>
                       <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints />
                           <RowConstraints fx:id="liveRowConstraints" />
                           <RowConstraints fx:id="instantiatedRowConstraints"/>
                        <RowConstraints />
                       </rowConstraints>
                       <children>
                           <Label styleClass="mandatory" text="*" />
                           <Label text="%createServerDialog.server.title" GridPane.columnIndex="1">
                                   <styleClass>
                                       <String fx:value="field-title" />
                                       <String fx:value="title" />
                                   </styleClass>
                           </Label>
                           <TextField fx:id="titleTextField" styleClass="title" GridPane.columnIndex="2" />
                           <Label text="%createServerDialog.server.description" GridPane.columnIndex="1" GridPane.rowIndex="1">
                               <styleClass>
                                   <String fx:value="field-title" />
                                   <String fx:value="description" />
                               </styleClass>
                           </Label>
                           <TextField fx:id="descriptionTextField" styleClass="description" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                           <Label text="%createServerDialog.server.password" GridPane.columnIndex="1" GridPane.rowIndex="2">
                               <styleClass>
                                   <String fx:value="field-title" />
                                   <String fx:value="password" />
                               </styleClass>
                           </Label>
                           <PasswordField fx:id="passwordTextField" styleClass="password" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                           <Label text="%createServerDialog.server.slots" GridPane.columnIndex="1" GridPane.rowIndex="3">
                               <styleClass>
                                   <String fx:value="field-title" />
                                   <String fx:value="slots" />
                               </styleClass>
                           </Label>
                           <Spinner fx:id="slotsSpinner" editable="true" styleClass="slots" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                           <CheckBox fx:id="lockCheckBox" styleClass="lock" text="%createServerDialog.server.lock" GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="4" >
                               <graphic>
                                   <FontAwesomeIconView />
                               </graphic>
                           </CheckBox>
                           <CheckBox fx:id="liveCheckBox" styleClass="live" text="%createServerDialog.server.live" GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="5" >
                               <graphic>
                                   <FontAwesomeIconView />
                               </graphic>
                           </CheckBox>
                           <CheckBox fx:id="instantiatedCheckBox" styleClass="instantiated" text="%createServerDialog.server.instantiated" GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="6" />
                       </children>
                   </GridPane>
               </content>
            </TitledPane>
            <TitledPane fx:id="systemTitledPane" collapsible="false" styleClass="system" text="%createServerDialog.system">
               <content>
                  <GridPane>
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" />
                      <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                         <Label text="%createServerDialog.system.language" >
                             <styleClass>
                                 <String fx:value="field-title" />
                                 <String fx:value="language" />
                             </styleClass>
                         </Label>
                         <ComboBox fx:id="languageComboBox" styleClass="language" prefWidth="150.0" GridPane.columnIndex="1" />
                         <Label text="%createServerDialog.system.region" GridPane.rowIndex="1" >
                             <styleClass>
                                 <String fx:value="field-title" />
                                 <String fx:value="region" />
                             </styleClass>
                         </Label>
                        <ComboBox fx:id="regionComboBox" styleClass="region" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>
               </content>
            </TitledPane>
             <TitledPane fx:id="videoSettingsTitledPane" collapsible="false" styleClass="video-settings" text="%createServerDialog.videoSettings" contentDisplay="RIGHT">
                 <graphic>
                     <Hyperlink fx:id="platinumHyperLink" text="%createServerDialog.videoSettings.platinumOptions" styleClass="platinum" onAction="#showStore" >
                         <graphic>
                             <FontAwesomeIconView />
                         </graphic>
                     </Hyperlink>
                 </graphic>
                 <content>
                     <GridPane>
                         <columnConstraints>
                             <ColumnConstraints hgrow="SOMETIMES" />
                             <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" />
                         </columnConstraints>
                         <rowConstraints>
                             <RowConstraints vgrow="SOMETIMES" />
                             <RowConstraints vgrow="SOMETIMES" />
                             <RowConstraints vgrow="SOMETIMES" />
                             <RowConstraints vgrow="SOMETIMES" />
                         </rowConstraints>
                         <children>
                             <Label text="%createServerDialog.videoSettings.framerate" >
                                 <styleClass>
                                     <String fx:value="field-title" />
                                     <String fx:value="framerate" />
                                 </styleClass>
                             </Label>
                             <ComboBox fx:id="framerateComboBox" styleClass="framerate" prefWidth="150.0" GridPane.columnIndex="1" />
                             <Label text="%createServerDialog.videoSettings.resolution" GridPane.rowIndex="1" >
                                 <styleClass>
                                     <String fx:value="field-title" />
                                     <String fx:value="resolution" />
                                 </styleClass>
                             </Label>
                             <ComboBox fx:id="resolutionComboBox" styleClass="resolution" prefWidth="150.0" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                             <Label text="%createServerDialog.videoSettings.bitrate" GridPane.rowIndex="2" >
                                 <styleClass>
                                     <String fx:value="field-title" />
                                     <String fx:value="bitrate" />
                                 </styleClass>
                             </Label>
                             <ComboBox fx:id="bitrateComboBox" styleClass="bitrate" visibleRowCount="15" prefWidth="150.0" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                             <Label text="%createServerDialog.videoSettings.decoder" GridPane.rowIndex="3" >
                                 <styleClass>
                                     <String fx:value="field-title" />
                                     <String fx:value="decoder" />
                                 </styleClass>
                             </Label>
                             <ComboBox fx:id="decoderComboBox" styleClass="decoder" prefWidth="150.0" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                         </children>
                     </GridPane>
                 </content>
             </TitledPane>
             <Label fx:id="mandatoryLabel" styleClass="mandatory" text="%createServerDialog.mandatoryFields" />
         </children>
      </VBox>
   </content>
    <buttonTypes>
        <ButtonType fx:constant="CANCEL" />
        <ButtonType fx:constant="OK" />
    </buttonTypes>
</DialogPane>

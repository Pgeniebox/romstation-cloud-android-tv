<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Entry Point"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btn_romstation"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="Romstation BETA V.1.0.0"
        android:layout_marginBottom="16dp"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btn_xbox"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="Xbox BETA V.6.0.0"
        android:textAllCaps="false" />
    <Button
        android:id="@+id/btn_playstation"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="Playstation BETA V.0.0.1"
        android:textAllCaps="false" />

</LinearLayout>

<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.romstation.application.view.control.cell.*?>
<?import java.lang.*?>
<DialogPane id="virtual-controller-configuration-dialog" fx:id="dialogPane"
            headerText="%virtualControllerConfigurationDialog.header" xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.romstation.application.bU">
    <graphic>
        <FontAwesomeIconView/>
    </graphic>
    <buttonTypes>
        <ButtonType fx:constant="CLOSE"/>
    </buttonTypes>
    <content>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints hgrow="SOMETIMES"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints/>
                <RowConstraints vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <ToolBar GridPane.columnSpan="2147483647">
                    <items>
                        <Label styleClass="device" text="%virtualControllerConfigurationDialog.device"/>
                        <ChoiceBox fx:id="devicesChoiceBox" prefWidth="200" styleClass="device"/>
                        <SplitMenuButton fx:id="refreshDevicesSplitMenuButton"
                                         text="%virtualControllerConfigurationDialog.device.refresh"
                                         styleClass="device" mnemonicParsing="false"
                                         onAction="#refreshDevices">
                            <graphic>
                                <FontAwesomeIconView/>
                            </graphic>
                            <items>
                                <CheckMenuItem fx:id="showAllDevicesCheckMenuItem"
                                               text="%virtualControllerConfigurationDialog.device.refresh.showAll"
                                               onAction="#refreshDevices"/>
                            </items>
                        </SplitMenuButton>
                        <Separator orientation="VERTICAL"/>
                        <Label styleClass="profile" text="%virtualControllerConfigurationDialog.profile"/>
                        <ChoiceBox fx:id="profilesChoiceBox" prefWidth="200" styleClass="profile"/>
                        <MenuButton styleClass="profile">
                            <graphic>
                                <FontAwesomeIconView/>
                            </graphic>
                            <items>
                                <MenuItem fx:id="createProfileMenuItem"
                                          text="%virtualControllerConfigurationDialog.profile.create"
                                          styleClass="create" onAction="#createProfile">
                                    <graphic>
                                        <FontAwesomeIconView/>
                                    </graphic>
                                </MenuItem>
                                <MenuItem fx:id="copyProfileMenuItem"
                                          text="%virtualControllerConfigurationDialog.profile.copy" styleClass="copy"
                                          onAction="#copyProfile">
                                    <graphic>
                                        <FontAwesomeIconView/>
                                    </graphic>
                                </MenuItem>
                                <MenuItem fx:id="renameProfileMenuItem"
                                          text="%virtualControllerConfigurationDialog.profile.rename"
                                          styleClass="rename" onAction="#renameProfile">
                                    <graphic>
                                        <FontAwesomeIconView/>
                                    </graphic>
                                </MenuItem>
                                <MenuItem fx:id="deleteProfileMenuItem"
                                          text="%virtualControllerConfigurationDialog.profile.delete"
                                          styleClass="delete" onAction="#deleteProfile">
                                    <graphic>
                                        <FontAwesomeIconView/>
                                    </graphic>
                                </MenuItem>
                            </items>
                        </MenuButton>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="configurationWizardButton" mnemonicParsing="false"
                                onAction="#configurationWizard" styleClass="configuration-wizard"
                                text="%virtualControllerConfigurationDialog.configurationWizard">
                            <graphic>
                                <FontAwesomeIconView/>
                            </graphic>
                        </Button>
                    </items>
                </ToolBar>
                <TitledPane fx:id="inputsTitledPane" collapsible="false"
                            text="%virtualControllerConfigurationDialog.inputs" maxHeight="Infinity"
                            GridPane.rowIndex="1">
                    <content>
                        <VBox>
                            <children>
                                <ToolBar>
                                    <items>
                                        <Button fx:id="bindInputButton" mnemonicParsing="false" onAction="#bindInput">
                                            <tooltip>
                                                <Tooltip text="%virtualControllerConfigurationDialog.inputs.bind"/>
                                            </tooltip>
                                            <graphic>
                                                <FontAwesomeIconView/>
                                            </graphic>
                                            <styleClass>
                                                <String fx:value="bind"/>
                                                <String fx:value="transparent"/>
                                            </styleClass>
                                        </Button>
                                        <Button fx:id="unbindInputButton" mnemonicParsing="false"
                                                onAction="#clearInputBinding">
                                            <tooltip>
                                                <Tooltip text="%virtualControllerConfigurationDialog.inputs.clear"/>
                                            </tooltip>
                                            <graphic>
                                                <FontAwesomeIconView/>
                                            </graphic>
                                            <styleClass>
                                                <String fx:value="clear"/>
                                                <String fx:value="transparent"/>
                                            </styleClass>
                                        </Button>
                                        <Button fx:id="configureInputButton" mnemonicParsing="false"
                                                onAction="#configureInput">
                                            <tooltip>
                                                <Tooltip text="%virtualControllerConfigurationDialog.inputs.settings"/>
                                            </tooltip>
                                            <graphic>
                                                <FontAwesomeIconView/>
                                            </graphic>
                                            <styleClass>
                                                <String fx:value="settings"/>
                                                <String fx:value="transparent"/>
                                            </styleClass>
                                        </Button>
                                    </items>
                                </ToolBar>
                                <TableView fx:id="inputsTableView" VBox.vgrow="ALWAYS" onKeyPressed="#keyPressed"
                                           onKeyReleased="#keyReleased">
                                    <columns>
                                        <TableColumn fx:id="inputNameTableColumn"
                                                     text="%virtualControllerConfigurationDialog.inputs.tableView.column.name"/>
                                        <TableColumn fx:id="inputBindingTableColumn"
                                                     text="%virtualControllerConfigurationDialog.inputs.tableView.column.binding"/>
                                        <TableColumn fx:id="inputStateTableColumn"
                                                     text="%virtualControllerConfigurationDialog.inputs.tableView.column.state"
                                                     styleClass="state">
                                            <cellFactory>
                                                <ProgressTableCell.Factory/>
                                            </cellFactory>
                                        </TableColumn>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <VBox styleClass="controller-content" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label fx:id="controllerNameLabel" styleClass="name"/>
                    <StackPane fx:id="controllerStackPane" styleClass="graphic-content" minWidth="0" minHeight="0"
                               prefWidth="0" prefHeight="0" VBox.vgrow="ALWAYS">
                        <ImageView fx:id="controllerImageView" pickOnBounds="true" preserveRatio="true"/>
                    </StackPane>
                </VBox>
            </children>
        </GridPane>
    </content>
</DialogPane>

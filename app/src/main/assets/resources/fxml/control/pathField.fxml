<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<fx:root styleClass="path-field" type="HBox" maxHeight="-Infinity" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TextField fx:id="textField" HBox.hgrow="ALWAYS" />
        <Button fx:id="explorerButton" mnemonicParsing="false">
            <graphic>
                <FontAwesomeIconView />
            </graphic>
        </Button>
    </children>
</fx:root>

<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.romstation.application.view.control.cell.entity.*?>
<?import org.romstation.application.view.control.cell.*?>
<?import java.lang.*?>

<?import org.romstation.application.view.control.SearchField?>
<VBox styleClass="systems-view" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.database.DatabaseSystemsViewController">
   <children>
      <ToolBar styleClass="transparent">
        <items>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#add" >
                <tooltip>
                    <Tooltip text="%database.systems.add"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
                <styleClass>
                    <String fx:value="add" />
                    <String fx:value="transparent" />
                </styleClass>
            </Button>
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#delete">
                <tooltip>
                    <Tooltip text="%database.systems.delete"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
                <styleClass>
                    <String fx:value="delete" />
                    <String fx:value="transparent" />
                </styleClass>
            </Button>
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#edit" >
                <tooltip>
                    <Tooltip text="%database.systems.edit"/>
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
                <styleClass>
                    <String fx:value="edit" />
                    <String fx:value="transparent" />
                </styleClass>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="searchResultLabel" styleClass="search-result">
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
            </Label>
            <SearchField fx:id="nameSearchField" promptText="%database.systems.search.promptText" />
        </items>
      </ToolBar>
      <TableView fx:id="tableView" VBox.vgrow="ALWAYS" onKeyPressed="#keyPressed">
        <columns>
            <TableColumn fx:id="idTableColumn" prefWidth="75.0" text="%database.systems.tableView.column.id" >
                <cellFactory>
                    <NumericTableCell.Factory />
                </cellFactory>
                <cellValueFactory>
                    <PropertyValueFactory property="id" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="nameTableColumn" prefWidth="75.0" text="%database.systems.tableView.column.name" >
                <cellValueFactory>
                    <PropertyValueFactory property="name" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="graphicTableColumn" prefWidth="75.0" text="%database.systems.tableView.column.graphic" >
                <cellValueFactory>
                    <PropertyValueFactory property="graphic" />
                </cellValueFactory>
                <cellFactory>
                    <ImageTableCell.Factory />
                </cellFactory>
            </TableColumn>
            <TableColumn fx:id="libraryReferencesTableColumn" prefWidth="75.0" text="%database.systems.tableView.column.references.library" >
                <cellFactory>
                    <NumericTableCell.Factory />
                </cellFactory>
            </TableColumn>
            <TableColumn fx:id="emulatorsReferencesTableColumn" prefWidth="75.0" text="%database.systems.tableView.column.references.emulators" >
                <cellFactory>
                    <NumericTableCell.Factory />
                </cellFactory>
            </TableColumn>
        </columns>
          <columnResizePolicy>
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
      </TableView>
   </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import java.lang.String?>

<ContextMenu fx:id="contextMenu" styleClass="game-context-menu" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.library.GameContextMenu">
  <items>
      <MenuItem fx:id="launchMenuItem" mnemonicParsing="false" onAction="#launch" styleClass="launch" text="%library.contextMenu.launch">
         <graphic>
            <FontAwesomeIconView />
         </graphic>
      </MenuItem>
      <SeparatorMenuItem/>
      <MenuItem fx:id="editMenuItem" mnemonicParsing="false" onAction="#edit" styleClass="edit" text="%library.contextMenu.edit">
          <graphic>
              <FontAwesomeIconView />
          </graphic>
      </MenuItem>
      <MenuItem fx:id="deleteMenuItem" mnemonicParsing="false" onAction="#delete" styleClass="delete" text="%library.contextMenu.delete">
         <graphic>
            <FontAwesomeIconView />
         </graphic>
      </MenuItem>
      <SeparatorMenuItem/>
      <MenuItem fx:id="browseMenuItem" mnemonicParsing="false" onAction="#browse" styleClass="explorer" text="%library.contextMenu.explorer">
         <graphic>
            <FontAwesomeIconView />
         </graphic>
      </MenuItem>
      <MenuItem fx:id="linkMenuItem" mnemonicParsing="false" onAction="#openLinks" styleClass="links" text="%library.contextMenu.links">
          <graphic>
              <FontAwesomeIconView />
          </graphic>
      </MenuItem>
  </items>
    <styleClass>
        <String fx:value="library" />
        <String fx:value="game" />
    </styleClass>
</ContextMenu>

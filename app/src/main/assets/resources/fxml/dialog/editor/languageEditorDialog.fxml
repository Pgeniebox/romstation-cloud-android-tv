<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.romstation.application.view.control.PathField?>
<DialogPane headerText="%languageEditorDialog.header" id="language-editor-dialog" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.aO">
   <buttonTypes>
      <ButtonType fx:constant="CANCEL" />
      <ButtonType fx:constant="OK" />
   </buttonTypes>
   <graphic>
      <FontAwesomeIconView />
   </graphic>
   <content>
      <GridPane styleClass="content">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints/>
          <RowConstraints vgrow="ALWAYS"/>
        </rowConstraints>
         <children>
             <VBox styleClass="named-field">
                 <Label text="%languageEditorDialog.graphic"  />
                 <PathField fx:id="graphicPathField" onAction="#selectPath"/>
             </VBox>
             <TitledPane text="%languageEditorDialog.translations" collapsible="false" GridPane.rowIndex="1">
                 <fx:include fx:id="name" source="/fxml/translationsPane.fxml"/>
             </TitledPane>
         </children>
      </GridPane>
   </content>
</DialogPane>

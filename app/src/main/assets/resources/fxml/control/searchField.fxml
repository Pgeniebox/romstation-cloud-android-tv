<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>


<?import java.lang.String?>
<fx:root alignment="CENTER_LEFT" styleClass="search-field" type="HBox" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <FontAwesomeIconView />
      <TextField fx:id="textField" HBox.hgrow="ALWAYS" />
      <Button fx:id="clearButton" mnemonicParsing="false" onAction="#clear">
         <graphic>
            <FontAwesomeIconView />
         </graphic>
         <styleClass>
            <String fx:value="clear"/>
         </styleClass>
      </Button>
   </children>
</fx:root>

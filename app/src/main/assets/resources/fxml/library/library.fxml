<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>
<?import org.romstation.application.view.control.SearchField?>

<BorderPane fx:id="root" id="library-view" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.library.LibraryController">
    <fx:define>
        <ToggleGroup fx:id="viewToggleGroup" />
    </fx:define>
    <top>
        <ToolBar>
            <Button onAction="#create">
                <styleClass>
                    <String fx:value="add" />
                    <String fx:value="transparent" />
                </styleClass>
                <tooltip>
                    <Tooltip text="%library.add" />
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
            </Button>
            <MenuButton>
                <styleClass>
                    <String fx:value="import" />
                    <String fx:value="transparent" />
                </styleClass>
                <tooltip>
                    <Tooltip text="%library.import" />
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
                <items>
                    <MenuItem text="%library.import.bulk" onAction="#bulkImport" />
                    <MenuItem text="%library.import.legacy" onAction="#importLegacy" />
                </items>
            </MenuButton>
            <Button onAction="#download">
                <styleClass>
                    <String fx:value="download" />
                    <String fx:value="transparent" />
                </styleClass>
                <tooltip>
                    <Tooltip text="%library.download" />
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
            </Button>
            <Button onAction="#upload">
                <styleClass>
                    <String fx:value="upload" />
                    <String fx:value="transparent" />
                </styleClass>
                <tooltip>
                    <Tooltip text="%library.upload" />
                </tooltip>
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
            </Button>
            <Separator orientation="VERTICAL"/>
            <Label styleClass="view" text="%library.view" />
            <HBox styleClass="views">
                <ToggleButton fx:id="tableViewToggle" mnemonicParsing="false" selected="true" toggleGroup="$viewToggleGroup">
                    <graphic>
                        <FontAwesomeIconView />
                    </graphic>
                    <tooltip>
                        <Tooltip text="%library.view.table" />
                    </tooltip>
                    <styleClass>
                        <String fx:value="table" />
                        <String fx:value="left-pill" />
                    </styleClass>
                </ToggleButton>
                <ToggleButton fx:id="gridViewToggle" mnemonicParsing="false" toggleGroup="$viewToggleGroup">
                    <graphic>
                        <FontAwesomeIconView />
                    </graphic>
                    <tooltip>
                        <Tooltip text="%library.view.grid" />
                    </tooltip>
                    <styleClass>
                        <String fx:value="grid" />
                        <String fx:value="right-pill" />
                    </styleClass>
                </ToggleButton>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="searchResultLabel" styleClass="search-result">
                <graphic>
                    <FontAwesomeIconView />
                </graphic>
            </Label>
            <SearchField fx:id="titleSearchField" styleClass="transparent" promptText="%library.search.promptText"/>
        </ToolBar>
    </top>
    <left>
        <fx:include fx:id="filters" source="filters.fxml" />
    </left>
    <center>
        <StackPane fx:id="view" styleClass="view" HBox.hgrow="ALWAYS">
            <children>
                <fx:include fx:id="tableview" source="tableView.fxml" visible="${tableViewToggle.selected}" />
                <fx:include fx:id="gridview" source="gridView.fxml" visible="${gridViewToggle.selected}" />
            </children>
        </StackPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<DialogPane fx:id="dialogPane" id="combo-box-choice-dialog" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.ay">
   <buttonTypes>
      <ButtonType fx:constant="CANCEL" />
      <ButtonType fx:constant="OK" />
   </buttonTypes>
   <content>
      <VBox styleClass="content">
         <children>
            <Label fx:id="contentLabel" />
            <ComboBox fx:id="comboBox" maxWidth="1.7976931348623157E308" prefWidth="150.0" />
         </children>
      </VBox>
   </content>
   <graphic>
      <FontAwesomeIconView />
   </graphic>
</DialogPane>

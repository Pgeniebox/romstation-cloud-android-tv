<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.GridView?>
<?import org.romstation.application.view.controller.library.grid.*?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.lang.String?>
<BorderPane styleClass="grid" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.library.grid.LibraryGridViewController">
   <fx:define>
      <ToggleGroup fx:id="sortToggleGroup" />
   </fx:define>
   <center>
      <GridView fx:id="gridView"/>
   </center>
   <bottom>
      <ToolBar styleClass="bottom" BorderPane.alignment="CENTER">
         <Label text="%library.view.grid.sort" />
         <ComboBox fx:id="sortFieldComboBox" prefWidth="150.0">
            <buttonCell>
               <LibraryGridViewSortFieldListCell />
            </buttonCell>
            <cellFactory>
               <LibraryGridViewSortFieldListCell.Factory />
            </cellFactory>
         </ComboBox>
         <HBox styleClass="sort-container">
            <ToggleButton fx:id="sortAscToggleButton" mnemonicParsing="false" selected="true" toggleGroup="$sortToggleGroup">
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <tooltip>
                  <Tooltip text="%library.view.grid.sort.order.asc" />
               </tooltip>
               <styleClass>
                  <String fx:value="sort" />
                  <String fx:value="asc" />
                  <String fx:value="left-pill" />
               </styleClass>
            </ToggleButton>
            <ToggleButton fx:id="sortDescToggleButton" mnemonicParsing="false" toggleGroup="$sortToggleGroup">
               <graphic>
                  <FontAwesomeIconView />
               </graphic>
               <tooltip>
                  <Tooltip text="%library.view.grid.sort.order.desc" />
               </tooltip>
               <styleClass>
                  <String fx:value="sort" />
                  <String fx:value="desc" />
                  <String fx:value="right-pill" />
               </styleClass>
            </ToggleButton>
         </HBox>
         <Region HBox.hgrow="ALWAYS"/>
         <Label text="%library.view.grid.zoom" />
         <Slider fx:id="zoomSlider" blockIncrement="0.1" minorTickCount="0" majorTickUnit="0.05" min="0.7" max="1.5" value="1" />
      </ToolBar>
   </bottom>
</BorderPane>

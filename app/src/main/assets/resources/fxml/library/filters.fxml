<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import org.romstation.application.view.control.cell.query.*?>
<?import org.romstation.application.view.controller.library.filters.*?>
<?import java.lang.String?>
<VBox styleClass="filters-pane" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.romstation.application.view.controller.library.filters.LibraryFiltersController">
    <Accordion fx:id="accordion" VBox.vgrow="ALWAYS">
        <panes>
            <TitledPane fx:id="systemsTitledPane" styleClass="systems" text="%library.filters.pane.systems">
                <content>
                    <ListView fx:id="systemsListView" />
                </content>
                <userData>
                    <LibraryFilterPane fx:constant="SYSTEMS" />
                </userData>
            </TitledPane>
            <TitledPane fx:id="genresTitledPane" styleClass="genres" text="%library.filters.pane.genres">
                <content>
                    <ListView fx:id="genresListView" />
                </content>
                <userData>
                    <LibraryFilterPane fx:constant="GENRES" />
                </userData>
            </TitledPane>
            <TitledPane fx:id="languagesTitledPane" styleClass="languages" text="%library.filters.pane.languages">
                <content>
                    <ListView fx:id="languagesListView" />
                </content>
                <userData >
                    <LibraryFilterPane fx:constant="LANGUAGES" />
                </userData>
            </TitledPane>
            <TitledPane fx:id="developersTitledPane" styleClass="developers" text="%library.filters.pane.developers">
                <content>
                    <ListView fx:id="developersListView" />
                </content>
                <userData>
                    <LibraryFilterPane fx:constant="DEVELOPERS" />
                </userData>
            </TitledPane>
            <TitledPane fx:id="publishersTitledPane" styleClass="publishers" text="%library.filters.pane.publishers">
                <content>
                    <ListView fx:id="publishersListView" />
                </content>
                <userData>
                    <LibraryFilterPane fx:constant="PUBLISHERS" />
                </userData>
            </TitledPane>
            <TitledPane fx:id="seriesTitledPane" styleClass="series" text="%library.filters.pane.series">
                <content>
                    <ListView fx:id="seriesListView" />
                </content>
                <userData>
                    <LibraryFilterPane fx:constant="SERIES" />
                </userData>
            </TitledPane>
            <TitledPane fx:id="tagsTitledPane" styleClass="tags" text="%library.filters.pane.tags">
                <content>
                    <ListView fx:id="tagsListView" />
                </content>
                <userData>
                    <LibraryFilterPane fx:constant="TAGS" />
                </userData>
            </TitledPane>
        </panes>
    </Accordion>
    <TitledPane fx:id="activeFiltersTitledPane" collapsible="false" styleClass="active-filters" text="%library.filters.pane.activeFilters">
        <graphic>
            <FontAwesomeIconView/>
        </graphic>
        <VBox>
            <ToolBar>
                <Button fx:id="resetFiltersButton" onAction="#resetFilters">
                    <styleClass>
                        <String fx:value="reset" />
                        <String fx:value="transparent" />
                    </styleClass>
                    <graphic>
                        <FontAwesomeIconView/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%library.filters.reset"/>
                    </tooltip>
                </Button>
                <Button fx:id="deleteFiltersButton" onAction="#deleteFilters">
                    <styleClass>
                        <String fx:value="delete" />
                        <String fx:value="transparent" />
                    </styleClass>
                    <graphic>
                        <FontAwesomeIconView/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%library.filters.delete"/>
                    </tooltip>
                </Button>
            </ToolBar>
            <ListView fx:id="activeFiltersListView">
                <cellFactory>
                    <SimpleNamedFilterListCell.Factory/>
                </cellFactory>
            </ListView>
        </VBox>
    </TitledPane>
</VBox>
